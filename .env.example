# modelmatch-backend — environment template. Copy to .env (never commit .env).

# --- Database (in-cluster Postgres; local dev via docker compose) ---
DATABASE_URL=postgresql+psycopg://modelmatch:modelmatch@localhost:5432/modelmatch

# --- Auth ---
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Recommender / savings knobs ---
BASELINE_MODEL_ID=Claude Sonnet 4.x           # demo baseline (computed, not run); a catalog model NAME
QUALITY_THRESHOLD=0.8                          # acceptance-rate gate for banking savings
# Deterministic-pick weights (w_q presets for the quality↔cost slider; w_c = 1 − w_q)
RANK_WEIGHT_LOW=0.85                            # budget_sensitivity=low  → quality-leaning
RANK_WEIGHT_MEDIUM=0.60                         # budget_sensitivity=medium
RANK_WEIGHT_HIGH=0.40                           # budget_sensitivity=high → cost-leaning
RECOMMENDATION_SHORTLIST_SIZE=3                 # how many ranked options to return/persist

# --- Feature flags ---
FEATURE_PROACTIVE_ADVISOR=false                # separable advisor (bonus); off by default

# --- AWS / in-cluster LLM (Bedrock Nova via IRSA; no static keys in cluster) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0         # in-cluster ingestion + chat
S3_BUCKET=modelmatch-ingestion-sources         # ingestion source docs

# --- LLM seam ---
LLM_CLIENT=fake                                # fake | anthropic | gemini | bedrock (real adapters need the 'llm' extra)
LLM_FIXTURES_DIR=tests/fixtures/llm_responses
# Provider creds (BYOK / IRSA) are read by each SDK directly — we never store them:
#   anthropic -> ANTHROPIC_API_KEY   gemini -> GEMINI_API_KEY/GOOGLE_API_KEY   bedrock -> AWS creds via IRSA (no static keys)

# --- Secret store (Jenkins/BYOK refs; never store plaintext in the DB) ---
SECRET_STORE=fake                              # fake (in-memory, dev/tests) — only value supported today; aws (Secrets Manager via IRSA) coming later

# --- CI integration (S11; ci-setup snippet + run ingest) ---
PUBLIC_BASE_URL=http://localhost:8000          # where the user's Jenkins POSTs ci-runs back (embedded in the snippet)
AGENT_IMAGE=modelmatch-agent:latest            # CI-agent image ref the snippet pulls (real ECR ref lands with infra)
# Provider config baked into the generated CI snippet (agent is BYOK). NEVER 'fake'.
CI_AGENT_LLM_CLIENT=anthropic                   # anthropic | gemini | bedrock (demo: Anthropic Haiku live)
CI_AGENT_MODEL=claude-haiku-4-5                 # model id the snippet passes as AGENT_MODEL
CI_AGENT_MAX_TOKENS=1024                        # per-run output cap on the user's key
CI_AGENT_TOKEN_CEILING=20000                    # per-run total-token ceiling (aborts the run)
# AWS_REGION (above) is reused by the Bedrock variant of the snippet

# --- HTTP / CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173
