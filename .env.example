# modelmatch-backend — environment template. Copy to .env (never commit .env).

# --- Database (in-cluster Postgres; local dev via docker compose) ---
DATABASE_URL=postgresql+psycopg://modelmatch:modelmatch@localhost:5432/modelmatch

# --- Auth ---
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Recommender / savings knobs ---
BASELINE_MODEL_ID=Claude Sonnet 4.5           # FALLBACK baseline for any task not listed below; a catalog model NAME
# Per-task baselines (P38c): each task type is measured by its own benchmark, so each
# gets its own "expensive default" to measure savings against. JSON object, task_type ->
# model NAME. The named model must be a scored row inside that task's own benchmark
# group, else the recommender falls back to the highest-cost row in the group.
BASELINE_MODEL_IDS={"ci_review":"Claude Sonnet 4.5","security_analysis":"Claude Opus 5"}
QUALITY_THRESHOLD=0.8                          # acceptance-rate gate for banking savings
# Deterministic-pick weights (w_q presets for the quality↔cost slider; w_c = 1 − w_q)
RANK_WEIGHT_LOW=0.85                            # budget_sensitivity=low  → quality-leaning
RANK_WEIGHT_MEDIUM=0.60                         # budget_sensitivity=medium
RANK_WEIGHT_HIGH=0.40                           # budget_sensitivity=high → cost-leaning
RECOMMENDATION_SHORTLIST_SIZE=3                 # how many ranked options to return/persist

# --- Feature flags ---
FEATURE_PROACTIVE_ADVISOR=false                # separable advisor (bonus); off by default

# --- AWS / in-cluster LLM (Bedrock Nova via IRSA; no static keys in cluster) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0    # in-cluster ingestion + chat (ap-south-1 needs the apac. inference profile; bare id is rejected on-demand)
S3_BUCKET=modelmatch-ingestion-sources-957261948820   # ingestion source docs

# --- LLM seam ---
# LLM_CLIENT here is the IN-CLUSTER surface (ingestion #3 + chat #4): fake | bedrock
# only (Nova via IRSA). anthropic/gemini are BYOK — agent-only (caps below; provider/model
# come from agent_runtime_config).
LLM_CLIENT=fake
LLM_FIXTURES_DIR=tests/fixtures/llm_responses
# Provider creds (BYOK / IRSA) are read by each SDK directly — we never store them:
#   anthropic -> ANTHROPIC_API_KEY   gemini -> GEMINI_API_KEY/GOOGLE_API_KEY   bedrock -> AWS creds via IRSA (no static keys)   deepseek -> DEEPSEEK_API_KEY   openai -> OPENAI_API_KEY (security task only, via OpenCode)

# --- Catalog ingestion (#3, S5b) ---
BLOB_STORE=fake                                # fake (in-process, dev/tests) — only value today; s3 (via IRSA) later
INGEST_MAX_TOKENS=2048                          # per-extraction output cap for in-cluster Nova
# Hard hourly token cap for OUR in-cluster Nova (Roey): ABORTS (429), not just alerts.
# Counted via the Postgres llm_usage tally (shared across replicas).
LLM_HOURLY_TOKEN_CAP=200000

# --- Secret store (Jenkins/BYOK refs; never store plaintext in the DB) ---
SECRET_STORE=fake                              # fake (in-memory, dev/tests) — only value supported today; aws (Secrets Manager via IRSA) coming later

# --- CI integration (S11; ci-setup snippet + run ingest) ---
PUBLIC_BASE_URL=http://localhost:8000          # where the user's Jenkins POSTs ci-runs back (embedded in the snippet)
AGENT_IMAGE=modelmatch-agent:latest            # review-task agent image the snippet runs (real ECR ref lands with infra)
AGENT_SECURITY_IMAGE=modelmatch-agent-security:latest   # security-task agent image (OpenCode loop; P38d split)
# Provider/model come from the selected model's trusted agent_runtime_config row.
CI_AGENT_MAX_TOKENS=1024                        # per-run output cap on the user's key
CI_AGENT_TOKEN_CEILING=20000                    # per-run total-token ceiling (aborts the run)
# AWS_REGION (above) is reused by the Bedrock variant of the snippet

# --- HTTP / CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173

# Optional Google sign-in: OAuth WEB client ID (public, no client secret needed).
# Register the frontend origin in Google Auth Platform; blank disables Google auth.
GOOGLE_CLIENT_ID=
