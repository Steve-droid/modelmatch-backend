# modelmatch-backend — environment template. Copy to .env (never commit .env).

# --- Database (in-cluster Postgres; local dev via docker compose) ---
DATABASE_URL=postgresql+psycopg://modelmatch:modelmatch@localhost:5432/modelmatch

# --- Auth ---
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Recommender / savings knobs ---
BASELINE_MODEL_ID=anthropic.sonnet            # demo baseline (computed, not run)
QUALITY_THRESHOLD=0.8                          # acceptance-rate gate for banking savings

# --- Feature flags ---
FEATURE_PROACTIVE_ADVISOR=false                # separable advisor (bonus); off by default

# --- AWS / in-cluster LLM (Bedrock Nova via IRSA; no static keys in cluster) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0         # in-cluster ingestion + chat
S3_BUCKET=modelmatch-ingestion-sources         # ingestion source docs

# --- LLM seam ---
LLM_CLIENT=fake                                # fake | bedrock | anthropic | gemini
LLM_FIXTURES_DIR=tests/fixtures/llm_responses

# --- HTTP / CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173
