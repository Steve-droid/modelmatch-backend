# Stable, non-secret CI delivery config for the AGENT pipeline (P19 — Jenkinsfile.agent).
# Loaded by Jenkinsfile.agent (readFile + parse), which FAILS if a required key is
# missing. These are publish targets + pinned tool refs, NOT per-run toggles — change
# them via a reviewed commit, never as a casual build parameter. NO SECRETS HERE:
# secret material (the deploy/read keys, the Docker Hub token) lives only in AWS Secrets
# Manager, referenced below by credential ID (an identifier, not a secret).
#
# The agent pipeline is PUBLISH-ONLY: it builds the modelmatch-agent image once, scans
# it, and on `main` pushes the SAME digest to (a) private ECR via the instance profile
# and (b) a public registry (Docker Hub) via CRED_DOCKERHUB. It NEVER bumps gitops /
# touches ArgoCD / runs kubectl/helm — so there is deliberately NO GITOPS_* key here.
#
# Format: KEY=value, one per line. '#' comments and blank lines ignored. No quoting.

# --- AWS / private ECR (account 957261948820, ap-south-1) ---
AWS_DEFAULT_REGION=ap-south-1
ECR_REGISTRY=957261948820.dkr.ecr.ap-south-1.amazonaws.com
AGENT_ECR_REPO=modelmatch-agent

# --- public registry (Docker Hub) for external/user pull ---
# Anonymous pulls work for external users; the push is authed by CRED_DOCKERHUB (a
# username+token, NEVER AWS IAM). DOCKERHUB_REGISTRY is the docker login host.
DOCKERHUB_REGISTRY=docker.io
DOCKERHUB_REPO=stevelevit/modelmatch-agent
# Moving "stable demo" tag external users / the /ci-setup default can pin (the SHA and
# SemVer tags are immutable; only this one is re-pointed each main publish).
DEMO_TAG=demo

# --- pinned tool images (digest-pinned for reproducibility; same pins as the BE pipeline) ---
# uv + python 3.12 — builds the --extra llm venv (anthropic/gemini/boto3) + runs the
# static/dep gate (bandit, pip-audit) and the offline unit suite.
UV_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm@sha256:85d4cb1afa769a7338e095b927bee941cf5ec92266c7424b3f6c0f2748567248
# trivy 0.71.1 (same pin proven on the controller in P17/P18).
TRIVY_IMAGE=aquasec/trivy:0.71.1@sha256:53570e6911c2361ebe7995228088cf83a6b9b73e7f3cdca44bd8f8f425e80fa7

# --- git target (the agent SemVer tag line lives in the SAME backend repo) ---
# Agent SemVer tags are namespaced `agent-vX.Y.Z` so they never collide with the
# backend pipeline's `vX.Y.Z` tags on this same repo. CRED_BE_READ_KEY fetches origin/main
# for change detection; CRED_BE_DEPLOY_KEY (WRITE) pushes the annotated agent SemVer tag.
BE_REPO_SSH=git@github.com:Steve-droid/modelmatch-backend.git

# --- credential IDs (== Secrets Manager secret names; identifiers, not secrets) ---
# CRED_BE_READ_KEY  (READ)  -> fetch origin/main in `Detect agent changes`.
# CRED_BE_DEPLOY_KEY (WRITE) -> push the annotated `agent-vX.Y.Z` git tag (main only).
# CRED_DOCKERHUB (user+token) -> docker login Docker Hub for the public push (main only).
CRED_BE_READ_KEY=modelmatch-jenkins-backend-read-key
CRED_BE_DEPLOY_KEY=modelmatch-jenkins-backend-deploy-key
CRED_DOCKERHUB=modelmatch-jenkins-dockerhub
