# Stable, non-secret CI delivery config for the BACKEND pipeline (P18).
# Loaded by the Jenkinsfile (readFile + parse), which FAILS if a required key is
# missing. These are publish targets + pinned tool refs, NOT per-run toggles — change
# them via a reviewed commit, never as a casual build parameter. NO SECRETS HERE:
# secret material (the deploy keys, the webhook HMAC) lives only in Jenkins / AWS
# Secrets Manager credentials, referenced below by credential ID (an identifier, not a
# secret). The checkout deploy key (read) is wired on the Multibranch job, not here.
#
# Format: KEY=value, one per line. '#' comments and blank lines ignored. No quoting.

# --- AWS / ECR (account 832285994273, ap-south-1) ---
AWS_DEFAULT_REGION=ap-south-1
ECR_REGISTRY=832285994273.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPO=modelmatch-backend

# --- E2E throwaway stack: the already-published FRONTEND image it runs against ---
# (the backend image under test is the freshly-built candidate; the FE is pulled).
E2E_FRONTEND_REPO=modelmatch-frontend
E2E_FRONTEND_TAG=1.0.1

# --- pinned tool images (digest-pinned for reproducibility) ---
# uv + python 3.12 — runs the static/dep gate (bandit, pip-audit) + unit/integration
# pytest, building the venv into the mounted workspace once in Build.
UV_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm@sha256:85d4cb1afa769a7338e095b927bee941cf5ec92266c7424b3f6c0f2748567248
# postgres 16 — the Integration/E2E compose DB (must match docker-compose.ci.yaml).
POSTGRES_IMAGE=postgres:16@sha256:081f1bc7bd5e143dbb6e487b710bbc27712cdcfaced4c071b8e47349aa1b4171
# Playwright image MUST match @playwright/test in ci/e2e/package.json (1.60.0).
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.60.0-noble@sha256:9bd26ad900bb5e0f4dee75839e957a89ae89c2b7ab1e76050e559790e946b948
# trivy 0.71.1 (same pin proven on the controller in P17).
TRIVY_IMAGE=aquasec/trivy:0.71.1@sha256:53570e6911c2361ebe7995228088cf83a6b9b73e7f3cdca44bd8f8f425e80fa7
# yq 4.47.1 (same pin proven on the controller in P17).
YQ_IMAGE=mikefarah/yq:4.47.1@sha256:b9285dd3b0bea3c34d0c54415dd48d767dabd9644d489bd6e253660847b58419

# --- release-tail git targets ---
BE_REPO_SSH=git@github.com:Steve-droid/modelmatch-backend.git
GITOPS_REPO=git@github.com:Steve-droid/modelmatch-gitops.git
GITOPS_VALUES=charts/modelmatch/values.yaml
GITOPS_MIGRATE_VALUES=charts/modelmatch-postgres/values.yaml

# --- credential IDs (== Secrets Manager secret names; identifiers, not secrets) ---
# BE_DEPLOY_KEY (WRITE) pushes the annotated SemVer tag; GITOPS_KEY (WRITE) commits the
# image-tag bump. The checkout READ key is configured on the Multibranch job itself.
CRED_BE_DEPLOY_KEY=modelmatch-jenkins-backend-deploy-key
CRED_GITOPS_KEY=modelmatch-jenkins-gitops-deploy-key
