    <mxCell id="rec_banner" value="The LLM FILLS the catalog (ingestion #3 — Bedrock Nova via IRSA, output validated as untrusted, idempotent via content-hash). The deterministic FORMULA ranks — no model call on the recommend path → same inputs = same output." style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;" vertex="1" parent="rec_layer">
