    <mxCell id="rec_catalog" value="benchmark catalog&#10;benchmark_result rows&#10;(model · benchmark · metric ·&#10;cost_per_mtok · context_window)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="rec_layer">
