    <mxCell id="rec_idem" value="idempotent&#10;content-hash →&#10;skip unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="rec_ingest">
