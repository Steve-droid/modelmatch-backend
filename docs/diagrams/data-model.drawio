    <mxCell id="dm_note" value="Dashed = secret refs / nullable FK / separable. No embedding columns anywhere (pgvector dropped). source_document.content_hash makes ingestion idempotent; retrieval_trace makes the chat's grounding auditable; llm_call records all three LLM uses (ci_run_id null for ingestion + chat)." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;spacingLeft=10;spacingRight=10;whiteSpace=wrap;" vertex="1" parent="dm_layer">
